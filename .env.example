# Base de datos PostgreSQL
DATABASE_URL="postgresql://ion:ion@localhost:5432/ionbikestore"

# URL pública del sitio (sin barra final). Se usa para los retornos de Mercado Pago.
SITE_URL="http://localhost:3000"
# Dominio de producción para Caddy (HTTPS automático). Ej: www.ionbikestore.com.ar
SITE_DOMAIN=""

# Mercado Pago (https://www.mercadopago.com.ar/developers/panel/app)
MP_ACCESS_TOKEN=""
# Clave secreta de webhooks (Tus integraciones > Webhooks > Clave secreta)
MP_WEBHOOK_SECRET=""
# Pago con QR (MODO, app del banco): external_id de la caja creada en Mercado Pago.
# Sin este dato el checkout no ofrece QR y la transferencia es solo al alias.
MP_QR_POS_ID=""

# Andreani: cotización de envíos en vivo (lo da Andreani al firmar el contrato).
# Sin estos datos se usa la tabla por zona de src/config/store.ts.
ANDREANI_USER=""
ANDREANI_PASSWORD=""
ANDREANI_CLIENTE=""
# Contrato del servicio de envío a domicilio
ANDREANI_CONTRATO=""
# Opcional: https://apisqa.andreani.com para probar contra el entorno de pruebas
ANDREANI_API_URL=""
# Panel de administración: clave para cifrar el 2FA en la base. Larga y aleatoria:
# `openssl rand -base64 48`. Si se cambia, hay que volver a crear los usuarios del panel.
ADMIN_SECRET=""
# Opcional: carpeta de las fotos subidas desde el panel (por defecto ./uploads)
UPLOADS_DIR=""

# Contraseña de la base en docker compose: larga y aleatoria (ej. `openssl rand -base64 32`)
POSTGRES_PASSWORD=""
