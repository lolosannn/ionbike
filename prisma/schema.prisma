generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  sort        Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  // Precio de lista (tarjeta) en centavos
  price       Int
  // Precio anterior tachado, en centavos (para ofertas)
  compareAt   Int?
  // Especificaciones técnicas: [{ "label": "Rodado", "value": "29" }, ...]
  specs       Json      @default("[]")
  images      String[]
  active      Boolean   @default(true)
  featured    Boolean   @default(false)
  // A pedido: se muestra sin stock y en vez de comprar se consulta por WhatsApp (gama alta)
  onRequest   Boolean   @default(false)
  salesCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id])
  variants    Variant[]
  inquiries   Inquiry[]

  @@index([categoryId])
}

model Variant {
  id         String      @id @default(cuid())
  sku        String      @unique
  color      String?
  colorHex   String?
  // Rodado o talle
  size       String?
  stock      Int         @default(0)
  // Las variantes que ya se vendieron no se borran (quedan en los pedidos): se archivan
  active     Boolean     @default(true)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

// Turno del taller (para dejar la bici en el local)
model Appointment {
  id        String            @id @default(cuid())
  // "AAAA-MM-DD" y "HH:MM", en hora argentina
  date      String
  time      String
  services  String[]
  name      String
  phone     String
  email     String?
  bike      String?
  notes     String?
  status    AppointmentStatus @default(PENDING)
  // Notas internas del taller (no las ve el cliente)
  adminNotes String?
  createdAt DateTime          @default(now())

  @@index([date])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// CARD, TICKET y MERCADOPAGO se cobran con Mercado Pago (Checkout Pro), cada uno
// limitado a sus medios; QR es un QR dinámico de Mercado Pago (interoperable: se paga
// con MODO o la app de cualquier banco). TRANSFER y CASH se cobran por fuera.
enum PaymentMethod {
  // Dinero en cuenta, Mercado Crédito o tarjetas guardadas en Mercado Pago
  MERCADOPAGO
  // Transferencia al alias o CBU / CVU (home banking, app del banco o MODO)
  TRANSFER
  // QR que se escanea desde MODO, Mercado Pago o la app del banco
  QR
  // Efectivo en el local
  CASH
  // Tarjeta de crédito o débito
  CARD
  // Efectivo en Pago Fácil o Rapipago
  TICKET
}

enum ShippingMethod {
  PICKUP
  DELIVERY
}

model Order {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  // Token aleatorio para que el cliente vea su pedido sin cuenta
  publicToken    String         @unique
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod
  shippingMethod ShippingMethod
  name           String
  email          String
  phone          String
  dni            String
  address        String?
  city           String?
  province       String?
  zip            String?
  notes          String?
  subtotal       Int
  discount       Int            @default(0)
  shippingCost   Int            @default(0)
  total          Int
  mpPreferenceId String?
  mpPaymentId    String?
  // QR dinámico de Mercado Pago (pago con QR)
  mpQrOrderId    String?
  mpQrData       String?
  mpQrExpiresAt  DateTime?
  // Cuándo se cobró (para las estadísticas de ventas por día)
  paidAt         DateTime?
  // Número de seguimiento de Andreani
  trackingCode   String?
  // Notas internas del local (no las ve el cliente)
  adminNotes     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          OrderItem[]
}

enum InquiryStatus {
  NEW
  CONTACTED
  RESERVED
  WON
  LOST
}

// Consulta por una bici a pedido (gama alta): el cliente deja sus datos desde la ficha
model Inquiry {
  id          String        @id @default(cuid())
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Se guarda el nombre por si el producto se borra después
  productName String
  // Color, talle o lo que el cliente quiera aclarar
  preference  String?
  name        String
  phone       String
  email       String?
  message     String?
  status      InquiryStatus @default(NEW)
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id])
  productName  String
  variantLabel String
  unitPrice    Int
  quantity     Int
}

// ---- Panel de administración ----

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  // scrypt, con sal propia (src/lib/admin/password.ts)
  passwordHash String
  // Secreto de la app de autenticación (2FA), cifrado con ADMIN_SECRET
  totpSecret   String
  // Último código usado: el mismo código no sirve dos veces
  lastTotpStep Int            @default(0)
  failedLogins Int            @default(0)
  lockedUntil  DateTime?
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
  logs         AdminLog[]
}

model AdminSession {
  id         String    @id @default(cuid())
  // Hash SHA-256 del token de la cookie: con la base sola no se puede entrar
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  @@index([userId])
}

// Registro de todo lo que se hace en el panel (quién, qué y cuándo)
model AdminLog {
  id        String     @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  detail    Json?
  ip        String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
}

// Promociones que se muestran en la web (ver src/config/promos.ts para los lugares)
model Promo {
  id         String    @id @default(cuid())
  title      String
  text       String?
  tag        String?
  href       String?
  cta        String?
  image      String?
  // Desde / hasta, inclusive, en hora de Argentina ("AAAA-MM-DD")
  startsOn   String?
  endsOn     String?
  // barra, inicio, listado, producto, carrito
  placements String[]
  // Slugs a los que aplica (vacío: promo general)
  categories String[]
  products   String[]
  priority   Int       @default(0)
  // Pausada a mano, aunque esté dentro de las fechas
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Estadísticas propias, sin cookies: cada visita o evento con un identificador anónimo
// del visitante que cambia todos los días (no se puede seguir a nadie de un día a otro).
model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  // view, cart, order, paid, inquiry, booking
  type      String
  path      String?
  // Hash diario de IP + navegador
  visitor   String
  // Dominio de origen (google.com, instagram.com…) o fuente utm
  source    String?
  // mobile, tablet, desktop
  device    String?
  productId String?
  // Monto en centavos (pedidos y pagos)
  value     Int?

  @@index([createdAt])
  @@index([type, createdAt])
}

